# Catalog provider: only printful is currently implemented
STORE_CATALOG_PROVIDER=printful
# Create a Printful Manual order / API store; create a token with read-products and write-orders permissions.
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
# Stripe account API key and webhook signing secret. Keep private. Never prefix with PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Actual primary site URL (no trailing slash), e.g. https://basednut.com
SITE_URL=
# In cents, applied once per order. Must cover your shipping economics; not a Printful quote.
STANDARD_SHIPPING_CENTS=599
# Allowed shipping countries for Stripe Checkout, comma-separated ISO 2-letter codes.
# Start US-only; validate shipping availability, costs and tax compliance before expanding.
SHIPPING_COUNTRIES=US
# Checkout defaults off. Stripe test payments do not submit paid Printful orders.
ENABLE_CHECKOUT=false
# Explicit gate for REAL charges and automatic fulfillment after a paid live Stripe event.
ENABLE_PRINTFUL_FULFILLMENT=false
# Optional: only enable after configuring Stripe Tax correctly.
STRIPE_AUTOMATIC_TAX=false
